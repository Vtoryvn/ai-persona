# Copy to fly.toml and set app from personas/<id>.yaml fly.app
app = "persona-first-timer"
primary_region = "sin"

[env]
  PERSONA_ID = "first-timer"
  MCP_VIEWPORT = "1280x720"
  PORT = "8080"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    method = "GET"
    path = "/health"

[[vm]]
  memory = "2gb"
  cpu_kind = "shared"
  cpus = 2

# LLM secrets: npm run persona -- sync-secrets  (reads local .env)
